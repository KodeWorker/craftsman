# Copy to .env and adjust. Referenced by docker-compose.yaml.

# --- llama.cpp (local LLM provider) ---
# .gguf file, relative to MODELS_DIR below (see docs/setup/llama.cpp.md for
# how to fetch one from unsloth).
LLM_MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
MODELS_DIR=./models
LLM_CTX_SIZE=131072
# Shared secret between llama-server and craftsman's LLM_API_KEY credential
# (see the docker/README setup steps). Generate with: openssl rand -hex 32
LLM_API_KEY=changeme

# --- craftsman workspace ---
# Bind-mounted into both the server and client containers as $HOME, so
# ~/.craftsman (db/artifacts/logs) and the file-based keyring are shared and
# editable from the host. `craftsman.yaml` ends up at
# $CRAFTSMAN_HOME/.craftsman/craftsman.yaml after `craftsman init`.
CRAFTSMAN_HOME=./craftsman_home
